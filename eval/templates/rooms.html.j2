<!DOCTYPE html>
<html>
<head>
    <title>Rooms</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>

    <main class="rooms-root">

        <h1>Liste des rooms</h1>

        <div id="rooms"></div>

    </main>

    <script>
        const userId = 1; // temporaire

        async function loadRooms() {
            const res = await fetch("/api/groups");
            const rooms = await res.json();

            const container = document.getElementById("rooms");
            container.innerHTML = "";

            rooms.forEach(room => {
                const div = document.createElement("div");
                div.className = "room-card";

                div.innerHTML = `
                    <div class="room-name">${room.name}</div>
                    <div>
                        <button onclick="subscribe(${room.id})">Subscribe</button>
                        <button onclick="unsubscribe(${room.id})">Unsubscribe</button>
                        <a href="/chat/${room.id}">
                            <button>Entrer</button>
                        </a>
                    </div>
                `;

                container.appendChild(div);
            });
        }

        async function subscribe(groupId) {
            await fetch("/api/subscribe", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({user_id: userId, group_id: groupId})
            });
            loadRooms();
        }

        async function unsubscribe(groupId) {
            await fetch(`/api/unsubscribe?user_id=${userId}&group_id=${groupId}`, {
                method: "DELETE"
            });
            loadRooms();
        }

        loadRooms();
    </script>

</body>
</html>
