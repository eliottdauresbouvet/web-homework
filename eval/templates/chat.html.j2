<!DOCTYPE html>
<html>
<!-- on lie le fichier js -->
<script src="/static/js/chat.js"></script> 
<head>
    <title>{{ group_name }}</title>
    <!-- on lie le fichier css -->
    <link rel="stylesheet" href="/static/css/style.css"> 
</head>
<body>
    <main class="chat-root">
        <!-- Le nom du groupe est affiché avec Jinja2 -->
        <h1>{{ group_name }}</h1>

        <div id="messages"></div>

        <div class="chat-input-row">
            <input id="messageInput" type="text" placeholder="Écris un message">
            <button id="sendBtn">Envoyer</button>
        </div>
    </main>
    <!-- Injecter les variables du groupe dans le JavaScript en les récupérant avec Jinja2 -->
    <script> 
        const groupId = {{ group_id }};
        const groupName = "{{ group_name }}"; 
    </script>  
</body>
</html>


